# Copy this file to .env.local and fill in the values.
# Supabase dashboard → Project Settings → API (or the "Connect" button)
# Use the publishable (anon) key only. Never put the secret / service_role key here:
# every VITE_ variable is bundled into the browser code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
